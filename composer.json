{
    "name": "softspring/dynamic-form-type",
    "description": "This component allows to create dynamic forms from an array configuration",
    "type": "symfony-library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "symfony/form": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.50",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.3",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "symfony/validator": "^6.4|^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\DynamicFormType\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\DynamicFormType\\Test\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-6.0": "6.0.x-dev"
        }
    }
}
