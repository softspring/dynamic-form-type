{
    "name": "softspring/dynamic-form-type",
    "description": "This component allows to create dynamic forms from an array configuration",
    "type": "symfony-library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "symfony/form": "^6.4|^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^2.2",
        "symfony/config": "^6.4|^7.3",
        "symfony/dependency-injection": "^6.4|^7.3",
        "symfony/http-kernel": "^6.4|^7.3",
        "symfony/validator": "^6.4|^7.3"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\DynamicFormType\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\DynamicFormType\\Test\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    }
}
